# ====================================================================
# RM-Retail POS Project (JIFFY POS) - Environment Variables Configuration
# Copy this file to .env or .env.local for local testing
# Add these variables to your Vercel Project Settings > Environment Variables
# ====================================================================

# 1. Supabase Project URL (e.g. https://lveyqbqecgvzfqufxmwf.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Service Role Key (Found in Supabase: Project Settings > API > service_role)
# NOTE: Required for backend administrative CRUD operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Supabase Anon Public Key (Found in Supabase: Project Settings > API > anon public)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 4. Secret key for signing Admin JWT Session cookies (random 32+ character string)
JWT_SECRET=super_secret_jwt_random_string_key_2026

# 5. Comma-separated Google accounts permitted to access Admin after Supabase OAuth verification
# Keep this in Vercel Environment Variables; do not commit real addresses here.
GOOGLE_ADMIN_EMAILS=admin@example.com

# Optional: Local server port (default: 3000)
PORT=3000
